  (attacker: $t_fire, defender: $t_water) isa efficacy, has factor 50;
  (attacker: $t_fire, defender: $t_rock) isa efficacy, has factor 50;
  (attacker: $t_fire, defender: $t_dragon) isa efficacy, has factor 50;
  (attacker: $t_grass, defender: $t_water) isa efficacy, has factor 200;
  (attacker: $t_grass, defender: $t_ground) isa efficacy, has factor 200;
  (attacker: $t_grass, defender: $t_rock) isa efficacy, has factor 200;
  (attacker: $t_grass, defender: $t_fire) isa efficacy, has factor 50;
  (attacker: $t_grass, defender: $t_grass) isa efficacy, has factor 50;
  # learning (ternary)
  (learner: $p_pikachu, learned: $m_thunderbolt, via: $mm_level_up) isa learning, has level 36;
