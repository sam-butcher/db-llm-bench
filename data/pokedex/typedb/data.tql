  # pokemon -> ability
  (owner: $p_bulbasaur, granted: $a_overgrow) isa ability-slot, has is-hidden false, has slot 1;
  (owner: $p_venusaur, granted: $a_overgrow) isa ability-slot, has is-hidden false, has slot 1;
  (owner: $p_charmander, granted: $a_blaze) isa ability-slot, has is-hidden false, has slot 1;
  (owner: $p_charizard, granted: $a_blaze) isa ability-slot, has is-hidden false, has slot 1;
  (owner: $p_charizard, granted: $a_solar_power) isa ability-slot, has is-hidden true, has slot 3;
  (owner: $p_squirtle, granted: $a_torrent) isa ability-slot, has is-hidden false, has slot 1;
