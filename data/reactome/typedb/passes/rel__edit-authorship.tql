given
    $authored_edit: integer,
    $edit_author: integer,
    $ordering: integer;
match
$p0 isa database-object, has db-id == $authored_edit;
$p1 isa database-object, has db-id == $edit_author;
insert
$x isa edit-authorship, links (authored-edit: $p0, edit-author: $p1), has ordering == $ordering;
