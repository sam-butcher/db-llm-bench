  $mm_egg isa move-method, has name "Egg";
  $p_bulbasaur isa pokemon, has name "Bulbasaur", has generation 1;
  $p_venusaur isa pokemon, has name "Venusaur", has generation 1;
  $p_charmander isa pokemon, has name "Charmander", has generation 1;
