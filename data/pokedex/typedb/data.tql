  (typed: $m_flamethrower, category: $t_fire) isa move-type;
  (typed: $m_fire_blast, category: $t_fire) isa move-type;
  (typed: $m_ember, category: $t_fire) isa move-type;
  (typed: $m_tackle, category: $t_normal) isa move-type;
  (typed: $m_ice_beam, category: $t_ice) isa move-type;
  (typed: $m_body_slam, category: $t_normal) isa move-type;
