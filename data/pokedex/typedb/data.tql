  $m_thunder isa move, has name "Thunder", has power 100, has damage-class "special";
  $m_thunder_shock isa move, has name "Thunder Shock", has power 40, has damage-class "special";
  $m_quick_attack isa move, has name "Quick Attack", has power 40, has damage-class "physical";
  $m_surf isa move, has name "Surf", has power 90, has damage-class "special";
  $m_hydro_pump isa move, has name "Hydro Pump", has power 110, has damage-class "special";
  $m_water_gun isa move, has name "Water Gun", has power 40, has damage-class "special";
  $m_flamethrower isa move, has name "Flamethrower", has power 90, has damage-class "special";
  $m_fire_blast isa move, has name "Fire Blast", has power 120, has damage-class "special";
  $m_ember isa move, has name "Ember", has power 40, has damage-class "special";
