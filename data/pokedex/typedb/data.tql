  $m_dragon_rush isa move, has name "Dragon Rush", has power 100, has damage-class "physical";
  $m_hyper_beam isa move, has name "Hyper Beam", has power 150, has damage-class "special";
  # move -> type
  (typed: $m_thunderbolt, category: $t_electric) isa move-type;
  (typed: $m_thunder, category: $t_electric) isa move-type;
  (typed: $m_thunder_shock, category: $t_electric) isa move-type;
  (typed: $m_quick_attack, category: $t_normal) isa move-type;
  (typed: $m_surf, category: $t_water) isa move-type;
