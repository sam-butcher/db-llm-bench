given
    $affected_event: integer,
    $disease_entity: integer,
    $functional_status: integer,
    $db_id: integer,
    $display_name: string,
    $schema_class: string;
match
$p0 isa reaction-like-event, has db-id == $affected_event;
$p1 isa physical-entity, has db-id == $disease_entity;
$p2 isa functional-status, has db-id == $functional_status;
insert
$x isa entity-functional-status, links (affected-event: $p0, disease-entity: $p1, functional-status: $p2), has db-id == $db_id, has display-name == $display_name, has schema-class == $schema_class;
