given
    $regulated_event: integer,
    $regulator: integer,
    $regulatory_activity: integer;
match
$p0 isa database-object, has db-id == $regulated_event;
$p1 isa database-object, has db-id == $regulator;
$p2 isa database-object, has db-id == $regulatory_activity;
insert
$x isa positive-gene-expression-regulation, links (regulated-event: $p0, regulator: $p1, regulatory-activity: $p2);
