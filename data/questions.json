    {
      "question": "Are there any Ford cars?",
      "difficulty": "medium",
      "expected": true,
      "queries": {
        "typeql": "with fun ford_exists() -> boolean:\n  match $_ isa car, has brand \"Ford\";\n  return check;\nmatch\nlet $exists = ford_exists();",
        "sql": "SELECT EXISTS (SELECT 1 FROM cars WHERE brand = 'Ford');",
        "cypher": "RETURN EXISTS { MATCH (:Car {brand: 'Ford'}) }",
        "dummy": "true"
      }
