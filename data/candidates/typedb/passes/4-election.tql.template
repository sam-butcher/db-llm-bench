# One election subtype, from the kind-filtered projection. `election` is
# abstract, so every instance is inserted as one of the nine leaf types; the
# loader's template can't take the type from the data, so load.sh renders this
# once per kind with {{TYPE}} substituted.
given
    $election_id: string,
    $election_date: date?,
    $election_current: boolean?;
insert
$election isa {{TYPE}}, has election_id == $election_id;
try { $election has election_date == $election_date; };
try { $election has election_current == $election_current; };
