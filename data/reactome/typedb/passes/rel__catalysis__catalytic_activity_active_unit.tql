given
    $catalyst: integer,
    $catalytic_activity: integer,
    $active_unit: integer,
    $db_id: integer,
    $display_name: string,
    $schema_class: string;
match
$p0 isa physical-entity, has db-id == $catalyst;
$p1 isa go-molecular-function, has db-id == $catalytic_activity;
$p2 isa physical-entity, has db-id == $active_unit;
insert
$x isa catalysis, links (catalyst: $p0, catalytic-activity: $p1, active-unit: $p2), has db-id == $db_id, has display-name == $display_name, has schema-class == $schema_class;
